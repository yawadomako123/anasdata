# ─────────────────────────────────────────────
#  Anasdata — Frontend environment variables
#  Copy this file to ".env" and fill in your values.
#  Only PUBLIC keys go here (they ship to the browser).
#  NEVER put your PaySwitch API User/Key, Supabase SERVICE ROLE key,
#  or Arkesel API key in this file. Those live in Supabase Edge
#  Function secrets (see README).
# ─────────────────────────────────────────────

# Your PaySwitch (theTeller) API KEY used by the inline checkout popup.
# The Merchant ID, API User and API Key (for server verification) go into
# Supabase function secrets, NOT here.
VITE_PAYSWITCH_API_KEY=

# Supabase project URL, e.g. https://abcdefgh.supabase.co
VITE_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# Supabase publishable/anon key — safe for the browser
VITE_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# (Optional) Your Arkesel USSD short-code, shown on the site so people
# know they can buy by dialing. Display only — e.g. *928*123#
VITE_USSD_CODE=
